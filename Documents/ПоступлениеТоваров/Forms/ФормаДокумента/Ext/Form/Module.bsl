&НаКлиенте
Процедура ТоварыНаименованиеПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ЦенаИзРегистра = ПолучитьЦенуНоменклатурыНаСервере(СтрокаТаблицы.Номенклатура);
	
	Если ЦенаИзРегистра > 0 Тогда
		СтрокаТаблицы.Стоимость = ЦенаИзРегистра;
	КонецЕсли;
	
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтоимостьПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.Сумма = СтрокаТаблицы.Стоимость * СтрокаТаблицы.Количество;
	
	ПроцентНДС = 0;
	Если СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		ПроцентНДС = 20;
	ИначеЕсли СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		ПроцентНДС = 10;
	ИначеЕсли СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС3") Тогда
		ПроцентНДС = 3;
	КонецЕсли;
	
	СтрокаТаблицы.СуммаНДС = Окр((СтрокаТаблицы.Сумма * ПроцентНДС) / 100, 2);
	
	СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.СуммаНДС + СтрокаТаблицы.Сумма;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатурыНаСервере(ВыбраннаяНоменклатура)
	
	Запрос = Новый Запрос;

	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦеныНоменкларуры.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменкларуры КАК ЦеныНоменкларуры
		|ГДЕ
		|	ЦеныНоменкларуры.Номенклатура = &Номенклатура";
		
	Запрос.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);
	Выборка = Запрос.Выполнить().Выбрать(); 	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь); 
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина); 
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	// Передаем владельцем именно вашу таблицу «Товары»
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элементы.Товары);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// Отменяем стандартный одиночный перенос платформы
	СтандартнаяОбработка = Ложь;
	
	// Собираем выбранные товары в массив
	МассивТоваров = Новый Массив;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивТоваров = ВыбранноеЗначение;
	Иначе
		МассивТоваров.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	// Заполняем вашу табличную часть «Товары»
	Для Каждого ТекТовар Из МассивТоваров Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекТовар) Или ЭтоГруппаНоменклатуры(ТекТовар) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = ТекТовар;
		НоваяСтрока.Количество = 1; // Базовое количество
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоГруппаНоменклатуры(СсылкаНаТовар)
	// Проверяем на сервере, не папка ли это
	Возврат СсылкаНаТовар.ЭтоГруппа;
	
КонецФункции