&НаКлиенте
Процедура ЗаполнитьИРассчитать(Команда)
	
	// Проверка периодов шапки
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Пожалуйста, заполните Дату начала и Дату окончания периода!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Дата начала не может быть больше Даты окончания!");
		Возврат;
	КонецЕсли;
	
	// Вызываем серверный расчет
	ЗаполнитьИРассчитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИРассчитатьНаСервере()
	
	Объект.Начисления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	Сотрудники.Должность КАК Должность,
		|	Сотрудники.Должность.ТарифнаяСтавка КАК ТарифнаяСтавка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ДатаПриема <= &ДатаОкончания
		|	И (Сотрудники.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Сотрудники.ДатаУвольнения >= &ДатаНачала)";
		
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Начисления.Добавить();
		НоваяСтрока.Сотрудник = Выборка.Сотрудник;
		НоваяСтрока.Должность = Выборка.Должность;
		НоваяСтрока.ТарифнаяСтавка = Выборка.ТарифнаяСтавка;
		НоваяСтрока.ОтработаноЧасов = 160; // Стандартное заполнение
		
		// По умолчанию галочки выключены
		НоваяСтрока.НадбавкаЗаСложность = Ложь;
		НоваяСтрока.ВыплатитьПремию   = Ложь;
		
		// Автоматически рассчитываем базовую сумму строки
		ПересчитатьСтрокуЗП(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСтрокуЗП(Строка)
	
	НормаВМесяц = 160;
	
	// 1. Расчет базового оклада от отработанных часов
	Если НормаВМесяц = 0 Тогда
		БазовыйОклад = 0;
	Иначе
		БазовыйОклад = (Строка.ТарифнаяСтавка / НормаВМесяц) * Строка.ОтработаноЧасов;
	КонецЕсли;
	
	БазовыйОклад = Окр(БазовыйОклад, 2);
	
	// 2. Расчет премии (+22.5% от оклада) по галочке ВыплатитьПремию
	Если Строка.ВыплатитьПремию Тогда
		СуммаПремии = Окр(БазовыйОклад * 0.225, 2); 
	Иначе
		СуммаПремии = 0;
	КонецЕсли;
	
	// 3. Расчет надбавки (+10% от оклада) по галочке НадбавкаЗаСложность
	Если Строка.НадбавкаЗаСложность Тогда
		СуммаСложности = Окр(БазовыйОклад * 0.10, 2);
	Иначе
		СуммаСложности = 0;
	КонецЕсли;
	
	// 4. Финальный результат падает в итоговую колонку
	Строка.СуммаНачисления = БазовыйОклад + СуммаПремии + СуммаСложности;
	
КонецПроцедуры

// ОБРАБОТЧИКИ СОБЫТИЙ ДЛЯ ЭКРАНА (Мгновенная реакция на твои клики)

&НаКлиенте
Процедура НачисленияОтработаноЧасовПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ПересчитатьСтрокуЗП(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияВыплатитьПремиюПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ПересчитатьСтрокуЗП(ТекущаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияНадбавкаЗаСложностьПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ПересчитатьСтрокуЗП(ТекущаяСтрока);
