&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		Возврат;
	КонецЕсли; 
	
	// Запрашиваем на сервере актуальную цену и остаток товара по выбранному складу
    ДанныеСклада = ПолучитьДанныеСкладаНаСервере(СтрокаТаблицы.Номенклатура, Объект.Склад);
	// Заполняем полученные данные в строку таблицы
	СтрокаТаблицы.Стоимость = ДанныеСклада.Цена;
	СтрокаТаблицы.ОстатокНаСкладе = ДанныеСклада.Остаток; 
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтоимостьПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ПересчитатьСтрокуТаблицы(СтрокаТаблицы);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.Сумма = СтрокаТаблицы.Стоимость * СтрокаТаблицы.Количество;
	
	ПроцентНДС = 0;
	Если СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		ПроцентНДС = 20;
	ИначеЕсли СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		ПроцентНДС = 10;
	ИначеЕсли СтрокаТаблицы.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС3") Тогда
		ПроцентНДС = 3;
	КонецЕсли;
	
	СтрокаТаблицы.СуммаНДС = Окр((СтрокаТаблицы.Сумма * ПроцентНДС) / 100, 2);
	СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.СуммаНДС + СтрокаТаблицы.Сумма;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьМодульныйПодборНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.Оборудование) Тогда
		Сообщить("Пожалуйста, сначала выберите Оборудование в шапке документа!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		Сообщить("Пожалуйста, сначала выберите Склад в шапке документа!");
		Возврат;
	КонецЕсли;
	
	Параметр_Грузоподъемность = Объект.Оборудование.Грузоподъемность;
	Параметр_Остановки = Объект.Оборудование.КоличествоОстановок;
	Параметр_МашинноеПомещение = Объект.Оборудование.МашиннойПомещение; 
	
	ЗапросСостава = Новый Запрос;
	ЗапросСостава.Текст = 
		"ВЫБРАТЬ
		|	КомплектДляТовараСостав.Номенклатура КАК Номенклатура,
		|	КомплектДляТовараСостав.Количество КАК КоличествоНорма,
		|	КомплектДляТовараСостав.Ссылка.КоличествоОстановок КАК КомплектОстановки
		|ИЗ
		|	Справочник.КомплектДляТовара.Состав КАК КомплектДляТовараСостав
		|ГДЕ
		|	(КомплектДляТовараСостав.Ссылка.Грузоподъемность = &Грузоподъемность 
		|		ИЛИ КомплектДляТовараСостав.Ссылка.Грузоподъемность = 0)
		|	И (КомплектДляТовараСостав.Ссылка.КоличествоОстановок = &Остановки 
		|		ИЛИ КомплектДляТовараСостав.Ссылка.КоличествоОстановок = 0 
		|		ИЛИ КомплектДляТовараСостав.Ссылка.КоличествоОстановок = 1)
		|	И (КомплектДляТовараСостав.Ссылка.МашинноеПомещение = &МашинноеПомещение 
		|		ИЛИ КомплектДляТовараСостав.Ссылка.МашинноеПомещение = ЛОЖЬ)";
		
	ЗапросСостава.УстановитьПараметр("Грузоподъемность", Параметр_Грузоподъемность);
	ЗапросСостава.УстановитьПараметр("Остановки", Параметр_Остановки);
	ЗапросСостава.УстановитьПараметр("МашинноеПомещение", Параметр_МашинноеПомещение);
	
	ТаблицаСостава = ЗапросСостава.Выполнить().Выгрузить();
	
	Если ТаблицаСостава.Количество() = 0 Тогда
		Сообщить("Не найдено подходящих папок с нормативами для этого лифта!");
		Возврат;
	КонецЕсли;
	
	Объект.Товары.Очистить();
	
	Для Каждого СтрокаНормы Из ТаблицаСостава Цикл
		
		БазоваяНорма = СтрокаНормы.КоличествоНорма;
		ИмяМатериала = ВРег(СтрокаНормы.Номенклатура.Наименование); 
		
		Если (Найти(ИмяМатериала, "КАНАТ") > 0 ИЛИ Найти(ИмяМатериала, "ТРОС") > 0) 
			И СтрокаНормы.КомплектОстановки = 1 Тогда
			КоличествоДляСписания = БазоваяНорма * Параметр_Остановки;
		ИначеЕсли ИмяМатериала = "ЛИСТ 10" ИЛИ ИмяМатериала = "ЛИСТ 08" Тогда
			КоличествоДляСписания = БазоваяНорма * (Параметр_Грузоподъемность / 100);
		Иначе
			КоличествоДляСписания = БазоваяНорма;
		КонецЕсли;
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаНормы.Номенклатура;
		НоваяСтрока.Количество = КоличествоДляСписания;
		
		ЦенаИзРегистра = ПолучитьЦенуНоменклатурыНаСервере(СтрокаНормы.Номенклатура);
		НоваяСтрока.Стоимость = ЦенаИзРегистра;
		
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Стоимость;
		НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
		НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20"); 
		НоваяСтрока.СуммаНДС = Окр((НоваяСтрока.Сумма * 20) / 100, 2);
		НоваяСтрока.СуммаСНДС = НоваяСтрока.СуммаНДС + НоваяСтрока.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеСкладаНаСервере(ВыбраннаяНоменклатура, ВыбранныйСклад)
	
	СтруктураРезультата = Новый Структура("Цена, Остаток", 0, 0);
	
	ЗапросЦены = Новый Запрос;
	ЗапросЦены.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1 ЦеныНоменкларуры.Цена КАК Цена 
		|ИЗ РегистрСведений.ЦеныНоменкларуры КАК ЦеныНоменкларуры 
		|ГДЕ ЦеныНоменкларуры.Номенклатура = &Номенклатура";
	ЗапросЦены.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);
	ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
	Если ВыборкаЦены.Следующий() Тогда
		СтруктураРезультата.Цена = ВыборкаЦены.Цена;
	КонецЕсли;
	
	ЗапросОстатка = Новый Запрос;
	ЗапросОстатка.Текст = 
		"ВЫБРАТЬ ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Номенклатура И Склад = &Склад) КАК ОстаткиТоваровОстатки";
	ЗапросОстатка.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);
	ЗапросОстатка.УстановитьПараметр("Склад", ВыбранныйСклад);
	ВыборкаОстатка = ЗапросОстатка.Выполнить().Выбрать();
	Если ВыборкаОстатка.Следующий() Тогда
		СтруктураРезультата.Остаток = ВыборкаОстатка.Остаток;
	КонецЕсли;
	
	Возврат СтруктураРезультата;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатурыНаСервере(ВыбраннаяНоменклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1 ЦеныНоменкларуры.Цена КАК Цена ИЗ РегистрСведений.ЦеныНоменкларуры КАК ЦеныНоменкларуры ГДЕ ЦеныНоменкларуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Цена, 0);
КонецФункции

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	ОбновитьОстаткиТаблицыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиТаблицыНаСервере()
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		 Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			 ДанныеСклада = ПолучитьДанныеСкладаНаСервере(СтрокаТовара.Номенклатура, Объект.Склад);
			 СтрокаТовара.ОстатокНаСкладе = ДанныеСклада.Остаток;
		 КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПоХарактеристикам(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Оборудование) Тогда
		ПоказатьПредупреждение(, "Сначала выберите Оборудование в шапке документа!");
		Return;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь); 
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина); 
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.КомплектДляТовара.ФормаВыбора", ПараметрыФормы, Элементы.Товары);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МассивВыбранныхКомплектов = Новый Массив;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивВыбранныхКомплектов = ВыбранноеЗначение;
	Иначе
		МассивВыбранныхКомплектов.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧастьНаСервере(МассивВыбранныхКомплектов);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере(Знач МассивВыбранныхКомплектов)
	
	ЛифтОстановки = 1;
	ЛифтВысота = 1;
	
	ЗапросЛифт = Новый Запрос;
	ЗапросЛифт.Текст = 
		"ВЫБРАТЬ
		|	Оборудование.КоличествоОстановок КАК КоличествоОстановок,
		|	Оборудование.ВысотаПодъема КАК ВысотаПодъема
		|ИЗ
		|	Справочник.Оборудование КАК Оборудование
		|ГДЕ
		|	Оборудование.Ссылка = &Ссылка";
	
	ЗапросЛифт.УстановитьПараметр("Ссылка", Объект.Оборудование);
	ВыборкаЛифт = ЗапросЛифт.Выполнить().Выбрать();
	
	Если ВыборкаЛифт.Следующий() Тогда
		Если ЗначениеЗаполнено(ВыборкаЛифт.КоличествоОстановок) И ВыборкаЛифт.КоличествоОстановок > 0 Тогда
			ЛифтОстановки = ВыборкаЛифт.КоличествоОстановок;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаЛифт.ВысотаПодъема) И ВыборкаЛифт.ВысотаПодъема > 0 Тогда
			ЛифтВысота = ВыборкаЛифт.ВысотаПодъема;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекКомплект Из МассивВыбранныхКомплектов Цикл
		
		БазовыеОстановкиКомплекта = ТекКомплект.КоличествоОстановок;
		БазоваяВысотаКомплекта   = ТекКомплект.ВысотаПодъема;
		
		Множитель = 1; 		
		Если ЗначениеЗаполнено(БазовыеОстановкиКомплекта) И БазовыеОстановкиКомплекта > 0 Тогда
			Множитель = ЛифтОстановки / БазовыеОстановкиКомплекта;
			
		ИначеЕсли ЗначениеЗаполнено(БазоваяВысотаКомплекта) И БазоваяВысотаКомплекта > 0 Тогда
			Множитель = ЛифтВысота / БазоваяВысотаКомплекта;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КомплектДляТовараСостав.Номенклатура КАК Номенклатура,
			|	КомплектДляТовараСостав.Количество КАК Количество
			|ИЗ
			|	Справочник.КомплектДляТовара.Состав КАК КомплектДляТовараСостав
			|ГДЕ
			|	(КомплектДляТовараСостав.Ссылка В ИЕРАРХИИ(&Родитель)
			|	ИЛИ КомплектДляТовараСостав.Ссылка = &Родитель)";
		
		Запрос.УстановитьПараметр("Родитель", ТекКомплект);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			
			НоваяСтрока.Количество = Выборка.Количество * Множитель;
			
			ДанныеСклада = ПолучитьДанныеСкладаНаСервере(НоваяСтрока.Номенклатура, Объект.Склад);
			НоваяСтрока.Стоимость = ДанныеСклада.Цена; 
			НоваяСтрока.ОстатокНаСкладе = ДанныеСклада.Остаток;
			
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Стоимость;
			НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
			НоваяСтрока.СуммаНДС = Окр((НоваяСтрока.Сумма * 20) / 100, 2);
			НоваяСтрока.СуммаСНДС = НоваяСтрока.СуммаНДС + НоваяСтрока.Сумма;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСоставПапкиНаСервере(Знач РодительскаяПапка)
	
	СписокМатериалов = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомплектДляТовараСостав.Номенклатура КАК Номенклатура,
		|	КомплектДляТовараСостав.Количество КАК Количество
		|ИЗ
		|	Справочник.КомплектДляТовара.Состав КАК КомплектДляТовараСостав
		|ГДЕ
		|	(КомплектДляТовараСостав.Ссылка В ИЕРАРХИИ(&Родитель)
		|	ИЛИ КомплектДляТовараСостав.Ссылка = &Родитель)";
	
	Запрос.УстановитьПараметр("Родитель", РодительскаяПапка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			СтруктураСтроки = Новый Структура("Номенклатура, Количество", Выборка.Номенклатура, Выборка.Количество);
			СписокМатериалов.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокМатериалов;
	
КонецФункции
