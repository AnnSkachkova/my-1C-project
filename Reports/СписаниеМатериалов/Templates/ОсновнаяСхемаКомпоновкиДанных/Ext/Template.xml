		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Оборудование</dataPath>
			<field>Оборудование</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СписаниеТоваров.Оборудование КАК Оборудование,
	СписаниеТоваровТовары.Номенклатура КАК Номенклатура,
	СписаниеТоваровТовары.Количество КАК Количество,
	СписаниеТоваровТовары.Стоимость КАК Стоимость,
	СписаниеТоваровТовары.Сумма КАК Сумма
ИЗ
	Документ.СписаниеТоваров.Товары КАК СписаниеТоваровТовары
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеТоваров КАК СписаниеТоваров
		ПО СписаниеТоваровТовары.Ссылка = СписаниеТоваров.Ссылка
ГДЕ
	СписаниеТоваровТовары.Ссылка.Проведен = &amp;ИСТИНА
	И СписаниеТоваровТовары.Ссылка.Дата МЕЖДУ &amp;НачалоПериода  И &amp;КонецПериода</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
